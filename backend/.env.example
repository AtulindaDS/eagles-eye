# ==============================================================================
# Eagles Eye — Backend Environment Configuration Template
# Team: Ugandan Eagles (Pre-DevFest Hackathon Kampala 2026)
# Instructions: Copy this file to .env (`cp .env.example .env`) and supply keys.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# Environment Mode (development / production)
FLASK_ENV=development

# Google Gemini API Key (Owned by Lyazi)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Project ID for Firestore persistence (Owned by Derek)
GOOGLE_CLOUD_PROJECT=eagles-eye-hackathon-2026
